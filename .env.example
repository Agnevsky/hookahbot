# ─── Telegram ────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ─── PostgreSQL ──────────────────────────────────────────────────
# Эти три переменные создают базу внутри контейнера postgres
POSTGRES_USER=hookah
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hookah_bot

# Строка подключения для бота.
# ВАЖНО: хост — имя сервиса из docker-compose (postgres), а НЕ localhost.
# Логин/пароль/база должны совпадать с POSTGRES_* выше.
DATABASE_URL=postgresql+asyncpg://hookah:change_me@postgres:5432/hookah_bot

# ─── Заполненность (необязательно, ниже — значения по умолчанию) ─
# Сколько позиций считается «100 %»
# CAPACITY_TOBACCO=50
# CAPACITY_BAR_DRINKS=15      # алко + б/алко вместе; снеки и чай не считаются
# CAPACITY_OTHER=15
# На каких процентах рассылать оповещение — JSON-список
# FILL_THRESHOLDS=[80,100]
