# ─── Telegram ────────────────────────────────────────────────────
# Токен от @BotFather
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# ─── PostgreSQL ──────────────────────────────────────────────────
# Эти три переменные создают базу внутри контейнера postgres
POSTGRES_USER=hookah
POSTGRES_PASSWORD=change_me
POSTGRES_DB=hookah_bot

# Строка подключения для бота.
# ВАЖНО: хост — имя сервиса из docker-compose (postgres), а НЕ localhost.
# Логин/пароль/база должны совпадать с POSTGRES_* выше.
DATABASE_URL=postgresql+asyncpg://hookah:change_me@postgres:5432/hookah_bot

# ─── Люди ────────────────────────────────────────────────────────
# Telegram ID узнать: написать боту @userinfobot.
# Администраторы: видят кнопки «📤 Отправить …» и управляют марками табака.
ADMIN_IDS=[111111111]

# Ответственные за категории (tobacco / bar / other): им уходят оповещения
# о заполненности, у админа на каждого есть кнопка «📤 Отправить …».
# name — в дательном падеже («Отправить Юре»). JSON в одну строку.
RESPONSIBLE=[{"name":"Юре","telegram_id":222222222,"categories":["tobacco"]},{"name":"Жене","telegram_id":333333333,"categories":["bar","other"]}]

# ─── Веб-приложение (Telegram Mini App) ──────────────────────────
# Домен, на который Caddy получит HTTPS-сертификат (DNS → IP сервера)
WEBAPP_DOMAIN=hookah.example.com
# Публичный адрес приложения. Пусто — кнопки приложения в боте нет.
WEBAPP_URL=https://hookah.example.com/

# ─── Заполненность (необязательно, ниже — значения по умолчанию) ─
# Сколько позиций считается «100 %»
# CAPACITY_TOBACCO=50
# CAPACITY_BAR_DRINKS=15      # алко + б/алко вместе; снеки и чай не считаются
# CAPACITY_OTHER=15
# На каких процентах рассылать оповещение — JSON-список
# FILL_THRESHOLDS=[50,80,100]
